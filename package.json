{
  "name": "qualibooth-action",
  "version": "1.0.4",
  "description": "QualiBooth GitHub Action — ESLint accessibility analysis for React, Vue, and HTML projects",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "ncc build src/index.js -o dist --license licenses.txt",
    "build:dev": "ncc build src/index.js -o dist --source-map",
    "lint": "eslint src/"
  },
  "dependencies": {
    "eslint": "^9.0.0",
    "@html-eslint/eslint-plugin": "^0.61.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-vue": "^9.33.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "vue-eslint-parser": "^9.4.3"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3"
  },
  "overrides": {
    "vscode-css-languageservice": "file:./src/stubs/vscode-css-languageservice"
  }
}
